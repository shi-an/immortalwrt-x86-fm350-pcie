# ============================================================================
# ImmortalWrt x86_64 FM350-GL PCIe 定制化配置
# ============================================================================
# 用于 x86/64 generic 主路由；FM350-GL 专用包由工作流固定注入。

# ============================================================================
# x86_64 构建目标
# ============================================================================
# 如果基于已有设备 base.config 追加，请先清理旧的 CONFIG_TARGET_* 目标项。
# CONFIG_TARGET_mediatek is not set
# CONFIG_TARGET_mediatek_filogic is not set
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set

# ============================================================================
# x86 镜像输出
# ============================================================================
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=y
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ============================================================================
# 基础系统包
# ============================================================================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_luci-lib-cbi=y
CONFIG_PACKAGE_luci-cbi=y
CONFIG_PACKAGE_luci-compat=y

# ============================================================================
# LuCI 主题和优化
# ============================================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ============================================================================
# 默认取消的包
# ============================================================================
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_wrtbwmon is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_rclone is not set
# CONFIG_PACKAGE_rclone-ng is not set
# CONFIG_PACKAGE_rclone-webui-react is not set

# ============================================================================
# x86 通用硬件支持
# ============================================================================
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8168=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_ethtool=y

# ============================================================================
# 网络和系统工具
# ============================================================================
# TUN 隧道支持
CONFIG_PACKAGE_kmod-tun=y

# 完整 IP 工具
CONFIG_PACKAGE_ip-full=y

# 网络抓包和诊断
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_lsof=y

# 终端工具
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# 防火墙
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 系统监控
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nethogs=y
CONFIG_PACKAGE_irqbalance=y

# SQM / CAKE / BBR
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 自动重启
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ============================================================================
# 编译优化
# ============================================================================
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="github.actions"
