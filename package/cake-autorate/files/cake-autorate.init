#!/bin/sh /etc/rc.common

START=97
STOP=4
USE_PROCD=1

start_service() {
	local enabled config_file instance

	config_load cake-autorate
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	for config_file in /etc/cake-autorate/config.*.sh; do
		[ -f "$config_file" ] || continue
		instance="${config_file##*/}"
		instance="${instance#config.}"
		instance="${instance%.sh}"

		procd_open_instance "$instance"
		procd_set_param command /bin/bash /usr/lib/cake-autorate/cake-autorate.sh "$config_file"
		procd_set_param env CAKE_AUTORATE_SCRIPT_PREFIX=/usr/lib/cake-autorate CAKE_AUTORATE_CONFIG_PREFIX=/etc/cake-autorate
		procd_set_param file /etc/config/cake-autorate "$config_file"
		procd_set_param respawn
		procd_set_param term_timeout 10
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done
}

service_triggers() {
	procd_add_reload_trigger cake-autorate
}
